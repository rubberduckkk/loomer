{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loomer.local/schemas/artifact-envelope.schema.json",
  "title": "Loomer Artifact Envelope",
  "description": "Shared metadata and provenance wrapper for domain-specific artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "artifact_type", "schema_version", "run_id", "created_at", "provenance", "payload"],
  "properties": {
    "artifact_id": { "type": "string", "minLength": 1 },
    "artifact_type": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_snapshot_id", "workflow_id", "workflow_version", "root_agent", "agents", "source_refs"],
      "properties": {
        "input_snapshot_id": { "type": "string", "minLength": 1 },
        "workflow_id": { "type": "string", "minLength": 1 },
        "workflow_version": { "type": "string", "minLength": 1 },
        "root_agent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["call_id", "agent_id", "agent_version", "prompt_version"],
            "properties": {
              "call_id": { "type": "string", "minLength": 1 },
              "parent_call_id": { "type": "string" },
              "agent_id": { "type": "string", "minLength": 1 },
              "agent_version": { "type": "string", "minLength": 1 },
              "prompt_version": { "type": "string", "minLength": 1 },
              "skills": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "version"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "version": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "version"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "version": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        },
        "shared_instructions_version": { "type": "string" },
        "source_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "payload": {}
  }
}
